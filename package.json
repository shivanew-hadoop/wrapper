{
  "name": "topper",
  "version": "14.3.0",
  "description": "Topper interview copilot with plain-text low-latency streaming, Windows system audio, RAG, and multi-screen capture-to-prompt.",
  "main": "main.js",
  "productName": "Topper",
  "author": "Topper",
  "scripts": {
    "start": "electron .",
    "dist": "npm run dist:installer",
    "dist:installer": "electron-builder --win nsis --x64",
    "dist:portable": "electron-builder --win portable --x64"
  },
  "dependencies": {
    "ws": "^8.17.0"
  },
  "devDependencies": {
    "electron": "^30.5.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.topper.meetingcaption",
    "productName": "Topper",
    "protocols": [
      {
        "name": "Topper Interview Copilot",
        "schemes": [
          "topper"
        ]
      }
    ],
    "directories": {
      "output": "dist/Topper-v${version}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Topper-Setup-v${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": false,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "Topper",
      "artifactName": "Topper-Setup-v${version}.${ext}"
    },
    "portable": {
      "artifactName": "Topper-v${version}-Portable.${ext}"
    },
    "files": [
      "main.js",
      "preload.js",
      "app-config.json",
      "setup/**/*",
      "overlay/**/*",
      "meet-controller/**/*",
      "transcriber/**/*",
      "audio-ws/**/*",
      "system-audio/**/*",
      "package.json",
      "!**/*.map",
      "!**/*.md",
      "!**/*.txt",
      "!**/*.log",
      "!**/test/**/*",
      "!**/tests/**/*",
      "!**/__tests__/**/*",
      "!**/docs/**/*",
      "!dist/**/*",
      "!*.zip"
    ],
    "asar": true,
    "compression": "maximum"
  }
}
