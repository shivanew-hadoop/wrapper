PORT=8080
DEEPGRAM_API_KEY=your_deepgram_key
OPENAI_API_KEY=your_openai_api_key
DATA_DIR=./data
JWT_SECRET=replace_with_at_least_32_random_characters
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_password
RAZORPAY_KEY_ID=rzp_test_replace
RAZORPAY_KEY_SECRET=replace
RAZORPAY_WEBHOOK_SECRET=replace_with_separate_webhook_secret
PLAN_PRICE_PAISE=59900
PLAN_CREDITS_MINUTES=60
LEGACY_LICENSE_FALLBACK=true
CORS_ORIGIN=http://localhost:8080

# Dynamic model routing. Terra remains the quality default for normal interview answers.

# Cheap auxiliary work: profile preparation and screen-text extraction.

# Final-answer quality safeguard: keep false so normal final interview answers use Terra/Sol only.
# Set true only if you also want tiny standalone definitions routed to Luna for extra savings.

# Backward-compatible override. Leave unset when using routing above.
# OPENAI_MODEL=gpt-5.6-terra
LLM_REASONING_EFFORT=low
LLM_VERBOSITY=low

EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=512
RAG_TOP_K=4
MAX_HISTORY_TURNS=3
DG_MODEL=nova-3
DG_LANGUAGE=en-US

LLM_FIRST_TOKEN_TIMEOUT_MS=5000
FAST_LEXICAL_THRESHOLD=0.34
OPENAI_MODEL=gpt-5.6-terra

## v13.4 uses Terra for all generative/profile/screen-extraction/final-answer calls.
## No Luna/Sol routing is performed.
