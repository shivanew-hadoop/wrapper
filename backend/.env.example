# Topper backend — conservative hybrid routing: Cerebras for simple questions, GPT-5.6 Sol Fast for quality-sensitive questions
PORT=8080
DEEPGRAM_API_KEY=your_deepgram_key

# Required: OpenAI remains the quality/fallback path + embeddings + vision
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-5.6-sol
OPENAI_PROFILE_MODEL=gpt-5.6-sol
OPENAI_VISION_MODEL=gpt-5.6-sol
OPENAI_SERVICE_TIER=fast

# Required for the low-latency/low-cost simple-question path
CEREBRAS_API_KEY=your_cerebras_key
CEREBRAS_MODEL=gpt-oss-120b
CEREBRAS_API_BASE=https://api.cerebras.ai/v1
CEREBRAS_SERVICE_TIER=default

# Conservative router. Ambiguous/contextual/complex work goes to Sol.
LLM_ROUTING_ENABLED=true
LLM_ROUTER_SOL_THRESHOLD=5
LLM_ROUTER_MIN_SIMPLE_CONFIDENCE=0.78

EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=512
RAG_TOP_K=4
MAX_HISTORY_TURNS=3
LLM_REASONING_EFFORT=low
LLM_VERBOSITY=medium
LLM_FIRST_TOKEN_TIMEOUT_MS=5000
FAST_LEXICAL_THRESHOLD=0.34
DG_MODEL=nova-3
DG_LANGUAGE=en-US
