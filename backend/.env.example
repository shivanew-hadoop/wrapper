# Topper backend — Cerebras text generation + existing OpenAI embeddings/vision
PORT=8080
DEEPGRAM_API_KEY=your_deepgram_key

# NEW: primary text-generation provider
CEREBRAS_API_KEY=your_cerebras_api_key
CEREBRAS_MODEL=gpt-oss-120b
CEREBRAS_API_BASE=https://api.cerebras.ai/v1
# default is safest on shared inference. Use auto only if your Cerebras account has service-tier access.
CEREBRAS_SERVICE_TIER=default

# KEEP: still required for RAG embeddings and screenshot/vision paths
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-5.6-terra
OPENAI_SERVICE_TIER=fast
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=512

# Existing Topper tuning
RAG_TOP_K=4
MAX_HISTORY_TURNS=3
LLM_REASONING_EFFORT=low
LLM_VERBOSITY=medium
LLM_FIRST_TOKEN_TIMEOUT_MS=5000
FAST_LEXICAL_THRESHOLD=0.34
DG_MODEL=nova-3
DG_LANGUAGE=en-US
