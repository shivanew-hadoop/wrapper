# Topper backend — OpenAI GPT-5.6 Sol Fast + existing Deepgram/RAG architecture
PORT=8080
DEEPGRAM_API_KEY=your_deepgram_key

# Primary text generation + existing embeddings/vision
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-5.6-sol
OPENAI_TERRA_MODEL=gpt-5.6-terra
# Optional: keep profile/vision on Sol too. You can override these independently later.
OPENAI_PROFILE_MODEL=gpt-5.6-sol
OPENAI_VISION_MODEL=gpt-5.6-sol
# Low-latency processing tier requested from OpenAI.
OPENAI_SERVICE_TIER=fast
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=512

# Existing Topper tuning
RAG_TOP_K=4
MAX_HISTORY_TURNS=3
LLM_REASONING_EFFORT=low
LLM_VERBOSITY=medium
LLM_FIRST_TOKEN_TIMEOUT_MS=5000
FAST_LEXICAL_THRESHOLD=0.34
DG_MODEL=nova-3
DG_LANGUAGE=en-US

# Optional live-answer provider selectable from Prepare Interview
CEREBRAS_API_KEY=your_cerebras_api_key
CEREBRAS_MODEL=gpt-oss-120b
CEREBRAS_API_BASE=https://api.cerebras.ai/v1
CEREBRAS_SERVICE_TIER=default


# Commerce / account portal
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
PUBLIC_BASE_URL=https://your-domain.example
PLAN_CREDITS_MINUTES=60
PLAN_PRICE_PAISE=59900
DESKTOP_INSTALLER_URL=https://github.com/shivanew-hadoop/topper-downloads/releases/latest/download/Topper-Setup.exe

# PhonePe Payment Gateway Standard Checkout v2
# Keep sandbox until PhonePe activates production credentials.
PHONEPE_ENV=sandbox
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=1
PHONEPE_WEBHOOK_USERNAME=
PHONEPE_WEBHOOK_PASSWORD=

# Public business identity shown on About/Contact/policy/footer pages.
# Use the exact details that match your PhonePe/Cashfree/Razorpay KYC application.
# For a sole proprietorship, BUSINESS_LEGAL_NAME should be the proprietor/trade name
# exactly as supported by the documents submitted to the payment gateway.
BUSINESS_BRAND_NAME=Topper
BUSINESS_LEGAL_NAME=
BUSINESS_TYPE=
BUSINESS_SUPPORT_EMAIL=support.topper@gmail.com
BUSINESS_SUPPORT_PHONE=
BUSINESS_ADDRESS_LINE1=
BUSINESS_ADDRESS_LINE2=
BUSINESS_CITY=
BUSINESS_STATE=
BUSINESS_POSTAL_CODE=
BUSINESS_COUNTRY=India
# Optional public registration identifiers. Leave blank when not applicable.
BUSINESS_GSTIN=
BUSINESS_UDYAM=

OPENAI_4O_MODEL=gpt-4o
OPENAI_4O_MINI_MODEL=gpt-4o-mini

# Google Gemini live-answer option
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
# Optional; normally leave at default.
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
