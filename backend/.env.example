# Topper backend — OpenAI GPT-5.6 Sol Fast + existing Deepgram/RAG architecture
PORT=8080
DEEPGRAM_API_KEY=your_deepgram_key

# Primary text generation + existing embeddings/vision
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-5.6-sol
# Optional: keep profile/vision on Sol too. You can override these independently later.
OPENAI_PROFILE_MODEL=gpt-5.6-sol
OPENAI_VISION_MODEL=gpt-5.6-sol
# Low-latency processing tier requested from OpenAI.
OPENAI_SERVICE_TIER=fast
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=512

# Existing Topper tuning
RAG_TOP_K=4
MAX_HISTORY_TURNS=3
LLM_REASONING_EFFORT=low
LLM_VERBOSITY=medium
LLM_FIRST_TOKEN_TIMEOUT_MS=5000
FAST_LEXICAL_THRESHOLD=0.34
DG_MODEL=nova-3
DG_LANGUAGE=en-US
